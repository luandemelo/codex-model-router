{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmr-latency-preference-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_phase",
    "brief",
    "preference",
    "basis",
    "tradeoff",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "cmr-latency-preference-v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_phase": {
      "enum": [
        "implementation",
        "final_review"
      ]
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^\\\\\\x00-\\x1f\\x7f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preference": {
      "const": "latency"
    },
    "basis": {
      "const": "explicit_task_opt_in"
    },
    "tradeoff": {
      "const": "latency_over_model_cost"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_byte",
        "end_byte",
        "quote"
      ],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
