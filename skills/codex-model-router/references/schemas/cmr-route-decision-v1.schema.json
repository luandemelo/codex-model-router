          "secrets",
          "security_risk",
          "structural_conflict",
          "trust_boundary",
          "untrusted_input"
        ]
      },
      "uniqueItems": true
    },
    "uncertainty_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "multiple_policy_facts",
          "negation_contrast_or_condition",
          "indirect_or_ambiguous_implication",
          "controller_uncertainty"
        ]
      },
      "uniqueItems": true
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "elevated",
        "critical"
      ]
    },
    "risk_signals": {
      "type": "array",
      "items": {
        "type": "string",
