    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "final_review",
        "audit",
        "reconciliation",
        "judgment",
        "implementation"
      ]
    },
    "brief": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
