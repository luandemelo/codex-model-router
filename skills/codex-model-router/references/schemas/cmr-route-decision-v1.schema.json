      "$ref": "#/$defs/Recurrence"
    },
    "worker": {
      "$ref": "#/$defs/Route"
    },
    "review": {
      "$ref": "#/$defs/ReviewRoute"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fork_turns",
        "context_mode",
        "execution_engine"
      ],
      "properties": {
        "fork_turns": {
          "const": "none"
        },
        "context_mode": {
          "const": "fresh"
        },
        "execution_engine": {
          "const": "superpowers-sdd"
        }
      }
    },
    "status": {
      "const": "ready"
    },
    "blocker_ids": {
      "type": "array",
      "maxItems": 0
    },
    "external_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExternalAction"
      },
      "uniqueItems": true
    },
    "decisive_reason_id": {
      "type": "string",
      "enum": [
        "architecture",
        "audit",
        "authentication",
        "authorization",
        "availability_or_integrity_impact",
        "backfill",
        "billing",
        "complex_local_execution",
