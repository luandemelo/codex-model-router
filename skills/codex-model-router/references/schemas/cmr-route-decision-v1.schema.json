                "release_create",
                "deploy",
                "install_skill",
                "install_plugin",
                "marketplace_publish"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "const": "completed"
            },
            "authorized": {
              "const": true
            },
            "preview": {
              "const": true
            },
            "readback": {
              "const": true
            },
            "blocker_ids": {
              "type": "array",
              "maxItems": 0
            },
            "authorization_id": {
              "type": "string",
              "minLength": 1
            },
            "preview_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "readback_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
