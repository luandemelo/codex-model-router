        "trust_boundary",
        "untrusted_input",
        "branch_final_review",
        "regression_after_declared_resolved",
        "recurring_failure",
        "default_clear_isolated_work"
      ]
    },
    "justification": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^\\\\\\x00-\\x1f\\x7f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning_effort"
      ],
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-sol"
          ]
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "xhigh",
            "max"
          ]
        }
      }
    },
    "ReviewRoute": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "reasoning_effort"
          ],
          "properties": {
            "model": {
              "const": "gpt-5.6-luna"
            },
            "reasoning_effort": {
              "const": "max"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "reasoning_effort"
          ],
          "properties": {
            "model": {
              "const": "gpt-5.6-sol"
            },
            "reasoning_effort": {
              "const": "xhigh"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "reasoning_effort"
          ],
          "properties": {
            "model": {
              "const": "gpt-5.6-sol"
            },
            "reasoning_effort": {
              "const": "max"
            }
          }
        }
      ]
    },
    "Recurrence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "reason_id",
            "defect_id"
          ],
          "properties": {
            "active": {
              "const": false
            },
            "reason_id": {
              "type": "null"
            },
            "defect_id": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "reason_id",
            "defect_id"
          ],
          "properties": {
            "active": {
              "const": true
            },
            "reason_id": {
              "type": "string",
              "enum": [
                "regression_after_declared_resolved",
                "recurring_failure"
              ]
            },
            "defect_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "ExternalAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "state",
            "authorized",
            "preview",
            "readback",
            "blocker_ids"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "github_authenticate",
                "repository_create",
                "repository_settings_update",
                "repository_topics_update",
                "issue_create",
                "issue_update",
                "issue_comment",
                "push",
                "pr_create",
                "pr_update",
                "merge",
                "tag_create",
                "release_create",
                "deploy",
                "install_skill",
                "install_plugin",
                "marketplace_publish"
              ]
            },
            "state": {
              "const": "blocked"
            },
            "authorized": {
              "const": false
            },
            "preview": {
              "const": false
            },
            "readback": {
              "const": false
            },
            "blocker_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "const": "external_target_missing"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "target",
            "state",
            "authorized",
            "preview",
            "readback",
            "blocker_ids"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "github_authenticate",
                "repository_create",
                "repository_settings_update",
                "repository_topics_update",
                "issue_create",
                "issue_update",
                "issue_comment",
                "push",
                "pr_create",
                "pr_update",
                "merge",
                "tag_create",
                "release_create",
                "deploy",
                "install_skill",
                "install_plugin",
                "marketplace_publish"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "const": "blocked"
            },
            "authorized": {
              "const": false
            },
            "preview": {
              "const": false
            },
            "readback": {
              "const": false
            },
            "blocker_ids": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "target",
            "state",
            "authorized",
            "preview",
            "readback",
            "blocker_ids",
            "authorization_id",
            "preview_sha256"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "github_authenticate",
                "repository_create",
                "repository_settings_update",
                "repository_topics_update",
                "issue_create",
                "issue_update",
                "issue_comment",
                "push",
                "pr_create",
                "pr_update",
                "merge",
                "tag_create",
                "release_create",
                "deploy",
                "install_skill",
                "install_plugin",
                "marketplace_publish"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "const": "ready"
            },
            "authorized": {
              "const": true
            },
            "preview": {
              "const": true
            },
            "readback": {
              "const": false
            },
            "blocker_ids": {
              "type": "array",
              "maxItems": 0
            },
            "authorization_id": {
              "type": "string",
              "minLength": 1
            },
            "preview_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "target",
            "state",
            "authorized",
            "preview",
            "readback",
            "blocker_ids",
            "authorization_id",
            "preview_sha256",
            "readback_id"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "github_authenticate",
                "repository_create",
                "repository_settings_update",
                "repository_topics_update",
                "issue_create",
                "issue_update",
                "issue_comment",
                "push",
                "pr_create",
