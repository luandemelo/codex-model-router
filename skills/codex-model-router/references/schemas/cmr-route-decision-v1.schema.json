          "price",
          "public_api_structural_change",
          "race_condition",
          "regulated_data",
          "rollback",
          "schema_migration",
          "secrets",
          "structural_conflict",
          "trust_boundary"
        ]
      },
      "uniqueItems": true
    },
    "derived_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "architecture_change",
          "architecture_approved",
          "audit",
          "security",
          "elevated_risk",
          "data_change",
          "financial",
          "clear_isolated_low_risk",
          "complex_local",
          "concurrency_control",
          "integration",
          "integrity_or_irreversibility",
          "critical_finding",
          "judgment",
          "low_blast_radius",
          "sensitive_data",
          "reconciliation"
        ]
      },
      "uniqueItems": true
    },
