{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmr-route-decision-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "role",
    "brief",
    "fact_ids",
    "uncertainty_ids",
    "risk_level",
    "risk_signals",
    "hard_gates",
    "derived_flags",
