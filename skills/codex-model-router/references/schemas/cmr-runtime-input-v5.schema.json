{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmr-runtime-input-v5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_phase",
    "current_defect_id",
    "failure_history",
    "review_scope",
    "authorization_registry",
    "routing_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "cmr-runtime-input-v5"
    },
    "task_phase": {
      "type": "string",
      "enum": [
        "implementation",
        "final_review"
      ]
    },
    "current_defect_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      }
    },
    "review_scope": {
      "type": "string",
      "enum": [
        "task",
        "branch"
      ]
    },
    "authorization_registry": {
      "$ref": "#/$defs/AuthorizationRegistry"
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "latency_preference"
      ],
      "properties": {
        "profile": {
          "const": {
            "profile_id": "luna-default-terra-latency-v1",
            "profile_sha256": "a4fbe81eeed636e5e431fd43cfaaf73a4b9374293546cecc731025373886378c"
          }
        },
        "latency_preference": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "task_id",
                "task_phase",
                "brief",
                "preference",
                "basis",
                "tradeoff",
                "evidence"
              ],
              "properties": {
                "schema_version": {
                  "const": "cmr-latency-preference-v1"
                },
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "task_phase": {
                  "enum": [
                    "implementation",
                    "final_review"
                  ]
                },
                "brief": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "size_bytes"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^\\\\\\x00-\\x1f\\x7f]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "preference": {
                  "const": "latency"
                },
                "basis": {
                  "const": "explicit_task_opt_in"
                },
                "tradeoff": {
                  "const": "latency_over_model_cost"
                },
                "evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start_byte",
                    "end_byte",
                    "quote"
                  ],
                  "properties": {
                    "start_byte": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_byte": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_phase": {
            "const": "final_review"
          }
        },
        "required": [
          "task_phase"
        ]
      },
      "then": {
        "properties": {
          "review_scope": {
            "const": "branch"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure_history": {
            "minItems": 1
          }
        },
        "required": [
          "failure_history"
        ]
      },
      "then": {
        "properties": {
          "current_defect_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "HistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_id",
        "event"
      ],
      "properties": {
        "defect_id": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "enum": [
            "attempt_completed_failed",
            "attempt_completed_passed",
            "declared_resolved",
            "reappeared"
          ]
        }
      }
    },
    "AuthorizationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "cmr-authorization-registry-v4"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationEntry"
          },
          "uniqueItems": true
        }
      }
    },
    "AuthorizationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target",
        "authorization_id",
        "preview_sha256"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "github_authenticate",
            "repository_create",
            "repository_settings_update",
            "repository_topics_update",
            "issue_create",
            "issue_update",
            "issue_comment",
            "push",
            "pr_create",
            "pr_update",
            "merge",
            "tag_create",
            "release_create",
            "deploy",
            "install_skill",
            "install_plugin",
            "marketplace_publish"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "preview_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "readback_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
