{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-first-routing.local/references/decision-record.schema.json",
  "title": "Quality-First Route Decision",
  "description": "Documentary-only historical record for inspecting quality-first Luna/Sol routing; it cannot authorize dispatch.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "role",
    "risk_signals",
    "hard_gates",
    "selected_model",
    "reasoning_effort",
    "review_model",
    "review_effort",
    "fork_turns",
    "execution_engine",
    "context_files",
    "justification"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "minLength": 1
    },
    "risk_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_model": {
      "type": "string",
      "enum": [
        "gpt-5.6-luna",
        "gpt-5.6-sol"
      ]
    },
    "model": {
      "type": "string",
      "enum": [
        "gpt-5.6-luna",
        "gpt-5.6-sol"
      ],
      "description": "Optional alias; when present it must equal selected_model."
    },
    "reasoning_effort": {
      "type": "string",
      "enum": [
        "xhigh",
        "max"
      ]
    },
    "effort": {
      "type": "string",
      "enum": [
        "xhigh",
        "max"
      ],
      "description": "Optional alias; when present it must equal reasoning_effort."
    },
    "review_model": {
      "type": "string",
      "enum": [
        "gpt-5.6-luna",
        "gpt-5.6-sol"
      ]
    },
    "review_effort": {
      "type": "string",
      "enum": [
        "xhigh",
        "max"
      ]
    },
    "review": {
      "type": "object",
      "description": "Optional aliases; canonical review_model/review_effort remain required.",
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-sol"
          ]
        },
        "selected_model": {
          "type": "string",
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-sol"
          ]
        },
        "effort": {
          "type": "string",
          "enum": [
            "xhigh",
            "max"
          ]
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "xhigh",
            "max"
          ]
        },
        "review_model": {
          "type": "string",
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-sol"
          ]
        },
        "review_effort": {
          "type": "string",
          "enum": [
            "xhigh",
            "max"
          ]
        }
      },
      "additionalProperties": false
    },
    "fork_turns": {
      "type": "string",
      "const": "none"
    },
    "execution_engine": {
      "type": "string",
      "const": "superpowers-sdd"
    },
    "execution_engines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "superpowers-sdd"
        ]
      }
    },
    "context_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "semantic_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "path", "sha256"],
      "properties": {
        "state": {
          "enum": ["skipped", "accepted", "amended", "blocked"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context_inherited": {
      "type": "boolean",
      "const": false
    },
    "inherited_history": {
      "type": "boolean",
      "const": false
    },
    "history_inherited": {
      "type": "boolean",
      "const": false
    },
    "context_mode": {
      "type": "string",
      "enum": [
        "fresh",
        "brief"
      ]
    },
    "final_review": {
      "type": "boolean"
    },
    "review_scope": {
      "type": "string",
      "enum": [
        "task",
        "branch"
      ]
    },
    "external_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalAction"
      }
    },
    "authorizations": {
      "type": "object",
      "description": "Legacy informational summary; it never supplies lifecycle state or authorization for an external_actions item.",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "external_action_authorizations": {
      "type": "object",
      "description": "Legacy informational summary; it never supplies lifecycle state or authorization for an external_actions item.",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "github_write_authorized": {
      "type": "boolean",
      "description": "Informational only; it never authorizes another independent action."
    },
    "downgrade_attempted": {
      "type": "boolean"
    },
    "downgrade_after_critical_signal": {
      "type": "boolean"
    },
    "critical_signal_detected": {
      "type": "boolean"
    },
    "critical_signal": {
      "type": "boolean"
    },
    "critical_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previous_route": {
      "$ref": "#/$defs/route"
    },
    "prior_route": {
      "$ref": "#/$defs/route"
    },
    "previous_model": {
      "type": "string"
    },
    "previous_reasoning_effort": {
      "type": "string"
    },
    "prior_model": {
      "type": "string"
    },
    "prior_reasoning_effort": {
      "type": "string"
    },
    "failure_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failureAttempt"
      }
    },
    "correction_attempts": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureAttempt"
          }
        }
      ]
    },
    "failed_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "same_defect": {
      "type": "boolean"
    },
    "defect_declared_resolved": {
      "type": "boolean"
    },
    "recurring_failure": {
      "type": "boolean"
    },
    "defect_reappeared_after_declared_resolved": {
      "type": "boolean"
    },
    "regression_after_declared_resolved": {
      "type": "boolean"
    },
    "reappeared_after_resolution": {
      "type": "boolean"
    },
    "defect_reappeared_after_resolution": {
      "type": "boolean"
    },
    "regression_after_resolved": {
      "type": "boolean"
    },
    "architecture_approved": {
      "type": "boolean"
    },
    "low_blast_radius": {
      "type": "boolean"
    },
    "judgment_required": {
      "type": "boolean"
    }
  },
  "$defs": {
    "externalAction": {
      "type": "object",
      "required": ["action", "state", "authorized", "preview", "readback"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "blocked",
            "ready",
            "completed"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "preview": {
          "type": "boolean"
        },
        "readback": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "blocked"
            },
            "authorized": {
              "const": false
            },
            "preview": {
              "const": false
            },
            "readback": {
              "const": false
            }
          }
        },
        {
          "required": ["target"],
          "properties": {
            "state": {
              "const": "ready"
            },
            "authorized": {
              "const": true
            },
            "preview": {
              "const": true
            },
            "readback": {
              "const": false
            }
          }
        },
        {
          "required": ["target"],
          "properties": {
            "state": {
              "const": "completed"
            },
            "authorized": {
              "const": true
            },
            "preview": {
              "const": true
            },
            "readback": {
              "const": true
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "selected_model": {
          "type": "string",
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-sol"
          ]
        },
        "model": {
          "type": "string",
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-sol"
          ]
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "xhigh",
            "max"
          ]
        },
        "effort": {
          "type": "string",
          "enum": [
            "xhigh",
            "max"
          ]
        }
      },
      "additionalProperties": false
    },
    "failureAttempt": {
      "type": "object",
      "required": ["defect_id", "complete", "outcome"],
      "properties": {
        "defect_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "failed",
            "failure",
            "passed",
            "success"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
