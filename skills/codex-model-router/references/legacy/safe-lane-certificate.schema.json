{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-first-routing.local/references/safe-lane-certificate.schema.json",
  "title": "Quality-First Global Safe-Lane Certificate",
  "description": "Documentary-only historical safe-lane certificate; it cannot authorize dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan", "entries"],
  "properties": {
    "schema_version": {"const": "qfr-safe-lane-v1"},
    "plan": {"$ref": "#/$defs/artifactReference"},
    "entries": {
      "description": "Closed entries. JSON Schema rejects exact duplicates; the dispatch CLI additionally enforces unique task_id+brief_sha256 keys.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "brief_sha256", "route", "justification"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "route": {"const": "luna_xhigh"},
          "justification": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
